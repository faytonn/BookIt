@using BookIt.Application.Interfaces.Services.UI
@using Microsoft.AspNetCore.Identity
@using BookIt.Domain.Entities

@inject ILayoutService _layoutService
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">


<!-- Mirrored from pixner.net/boleto/demo/index-2.html by HTTrack Website Copier/3.x [XR&CO'2014], Mon, 03 Feb 2025 20:06:53 GMT -->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    <link rel="stylesheet" href="~/user/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/user/assets/css/all.min.css">
    <link rel="stylesheet" href="~/user/assets/css/animate.css">
    <link rel="stylesheet" href="~/user/assets/css/flaticon.css">
    <link rel="stylesheet" href="~/user/assets/css/magnific-popup.css">
    <link rel="stylesheet" href="~/user/assets/css/odometer.css">
    <link rel="stylesheet" href="~/user/assets/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/user/assets/css/owl.theme.default.min.css">
    <link rel="stylesheet" href="~/user/assets/css/nice-select.css">
    <link rel="stylesheet" href="~/user/assets/css/jquery.animatedheadline.css">
    <link rel="stylesheet" href="~/user/assets/css/main.css">
    <link rel="stylesheet" href="~/user/assets/css/bookit.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)

@*     <link rel="shortcut icon" href="https://res.cloudinary.com/di3ourpee/image/upload/v1738766959/bookit./ev0nyzhntlkho22k7bd3.png" type="image/x-icon">
 *@
    <title>BookIt.</title>


</head>

<body>
    <!-- ==========Preloader========== -->
    <div class="preloader">
        <div class="preloader-inner">
            <div class="preloader-icon">
                <span></span>
                <span></span>
            </div>
        </div>
    </div>
    <!-- ==========Preloader========== -->
    <!-- ==========Overlay========== -->
    <div class="overlay"></div>
    <a href="#0" class="scrollToTop">
        <i class="fas fa-angle-up"></i>
    </a>
    <!-- ==========Overlay========== -->
    <!-- ==========Header-Section========== -->
    <header class="header-section">
        <div class="container">
            <div class="header-wrapper">
                <div class="logo">
                    <a asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/user/assets/images/logo/logo.png" alt="logo">
                    </a>
                </div>
                <ul class="menu">
                    <li>
                        <a asp-controller="Home" asp-action="Index">home</a>
                    </li>
                    <li>
                        <a asp-controller="Event" asp-action="Index">events</a>
                    </li>
                    <li class="lang-item">
                        <partial name="_LanguageChooser" />
                    </li>
                    <li class="header-button pr-0">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @* CSS-only menu (hover / keyboard focus): the template ships Bootstrap 4 without Popper *@
                            <div class="user-menu">
                                <a href="#0" class="user-menu-toggle" aria-haspopup="true">
                                    <i class="fas fa-user-circle"></i> @User.Identity!.Name <i class="fas fa-angle-down"></i>
                                </a>
                                <ul class="user-menu-list">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-tachometer-alt"></i> Admin panel</a></li>
                                    }
                                    @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                                    {
                                        <li><a asp-area="Admin" asp-controller="CheckIn" asp-action="Index"><i class="fas fa-qrcode"></i> Door check-in</a></li>
                                    }
                                    <li><a asp-area="" asp-controller="Account" asp-action="Profile"><i class="fas fa-user"></i> Profile</a></li>
                                    <li><a asp-area="" asp-controller="Account" asp-action="Settings"><i class="fas fa-cog"></i> Settings</a></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit"><i class="fas fa-sign-out-alt"></i> Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Log in</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-secondary">Register</a>
                        }
                    </li>
                </ul>
                <div class="header-bar d-lg-none">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </div>
    </header>
    <!-- ==========Header-Section========== -->
            @RenderBody()
    <!-- ==========Newslater-Section========== -->
    <footer class="footer-section">
        <div class="newslater-section padding-bottom">
            <div class="container">
                <div class="newslater-container bg_img" data-background="~/user/assets/images/newslater/newslater-bg01.jpg">
                    <div class="newslater-wrapper">
                        <h5 class="cate">subscribe to Boleto </h5>
                        <h3 class="title">to get exclusive benifits</h3>
                        <form class="newslater-form">
                            <input type="text" placeholder="Your Email Address">
                            <button type="submit">subscribe</button>
                        </form>
                        <p>We respect your privacy, so we never share your info</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="footer-top">
                <div class="logo">
                    <a asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/user/assets/images/footer/footer-logo.png" alt="footer">
                    </a>
                </div>
                <ul class="social-icons">
                    <li>
                        <a href="#0">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                    </li>
                    <li>
                        <a href="#0" class="active">
                            <i class="fab fa-twitter"></i>
                        </a>
                    </li>
                    <li>
                        <a href="#0">
                            <i class="fab fa-pinterest-p"></i>
                        </a>
                    </li>
                    <li>
                        <a href="#0">
                            <i class="fab fa-google"></i>
                        </a>
                    </li>
                    <li>
                        <a href="#0">
                            <i class="fab fa-instagram"></i>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="footer-bottom">
                <div class="footer-bottom-area">
                    <div class="left">
                        <p>Copyright © 2025.All Rights Reserved By <a href="#0">BookIt. </a></p>
                    </div>
                    <ul class="links">
                        <li>
                            <a href="#0">About</a>
                        </li>
                        <li>
                            <a href="#0">Terms Of Use</a>
                        </li>
                        <li>
                            <a href="#0">Privacy Policy</a>
                        </li>
                        <li>
                            <a href="#0">FAQ</a>
                        </li>
                        <li>
                            <a href="#0">Feedback</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>
    <!-- ==========Newslater-Section========== -->


    <script src="~/user/assets/js/jquery-3.3.1.min.js"></script>
    <script src="~/user/assets/js/modernizr-3.6.0.min.js"></script>
    <script src="~/user/assets/js/plugins.js"></script>
    <script src="~/user/assets/js/bootstrap.min.js"></script>
    <script src="~/user/assets/js/heandline.js"></script>
    <script src="~/user/assets/js/isotope.pkgd.min.js"></script>
    <script src="~/user/assets/js/magnific-popup.min.js"></script>
    <script src="~/user/assets/js/owl.carousel.min.js"></script>
    <script src="~/user/assets/js/wow.min.js"></script>
    <script src="~/user/assets/js/countdown.min.js"></script>
    <script src="~/user/assets/js/odometer.min.js"></script>
    <script src="~/user/assets/js/viewport.jquery.js"></script>
    <script src="~/user/assets/js/nice-select.js"></script>
    <script src="~/user/assets/js/main.js"></script>
    <script>
        // Event search bar (home + /Event): picking a location, date or category runs the search right away.
        // nice-select re-triggers "change" on the hidden <select>, so this covers the styled dropdowns too.
        $(document).on('change', '.ticket-search-form select, .ticket-search-form input[type=date]', function () {
            this.form.submit();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>


<!-- Mirrored from pixner.net/boleto/demo/index.html by HTTrack Website Copier/3.x [XR&CO'2014], Mon, 03 Feb 2025 20:06:31 GMT -->
</html>

@using System.Globalization
@{
    var current = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<select id="languageSelect" class="selectpicker" data-width="fit" aria-label="Language">
    <option value="en" selected="@(current == "en")">EN</option>
    <option value="az" selected="@(current == "az")">AZ</option>
    <option value="cs" selected="@(current == "cs")">CS</option>
</select>

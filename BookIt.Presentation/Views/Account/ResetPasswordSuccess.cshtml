@{
    ViewData["Title"] = "Password Reset";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body text-center">
                    <h2 class="card-title mb-4">@ViewData["Title"]</h2>
                    <p class="card-text">
                        Your password has been changed. You can now log in with the new password.
                    </p>
                    <div class="mt-4">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Go to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

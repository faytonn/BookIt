@model BookIt.Presentation.Models.EventDetailsViewModel
@{
    ViewData["Title"] = Model.Event.Title;
    var title = Model.Detail?.Title ?? Model.Event.Title;
}

<section class="details-banner event-details-banner hero-area bg_img seat-plan-banner" data-background="@Model.Event.ImagePath">
    <div class="container">
        <div class="details-banner-wrapper">
            <div class="details-banner-content style-two">
                <h3 class="title">@title</h3>
                <div class="tags">
                    <span>@Model.Event.CategoryName</span>
                    <span>@Model.Event.EventDate.ToString("f")</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="event-book-section padding-bottom">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="event-about padding-top">
                    <h4 class="title">About the event</h4>
                    @if (Model.Detail != null)
                    {
                        <p>@Model.Detail.Description</p>
                    }
                    else
                    {
                        <p>No description has been added yet.</p>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="event-book-wrapper padding-top">
                    <ul class="event-info">
                        <li><span class="label">Date</span> @Model.Event.EventDate.ToString("dddd, d MMMM yyyy")</li>
                        <li><span class="label">Time</span> @Model.Event.EventDate.ToString("HH:mm")</li>
                        <li><span class="label">Venue</span> @Model.Event.LocationName &middot; @Model.Event.HallName</li>
                        <li><span class="label">Price</span> @Model.Event.PriceRange</li>
                    </ul>
                    @if (Model.Event.IsSoldOut)
                    {
                        <span class="custom-button bg-secondary mt-3 disabled">sold out</span>
                    }
                    else
                    {
                        <a href="#seat-map" class="custom-button mt-3">choose seats</a>
                    }
                </div>
            </div>
        </div>

        @if (!Model.Event.IsSoldOut)
        {
            <div id="seat-map" class="row"
                 data-event-id="@Model.Event.Id"
                 data-authenticated="@(User.Identity?.IsAuthenticated == true ? "true" : "false")"
                 data-login-url="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Details", "Event", new { id = Model.Event.Id }) })"
                 data-profile-url="@Url.Action("Profile", "Account")">
                <div class="col-lg-8">
                    <h4 class="title mt-4">Pick your seats</h4>
                    <div class="seat-legend">
                        <span class="available">available</span>
                        <span class="held">held by someone</span>
                        <span class="sold">sold</span>
                        <span class="mine">yours</span>
                    </div>
                    <div class="seat-screen">stage</div>
                    <div id="seat-grid"></div>
                </div>
                <div class="col-lg-4">
                    <div class="event-book-wrapper mt-4">
                        <h5 class="title">Your holds</h5>
                        <p class="text-muted" style="font-size: 13px;">A held seat is reserved for you for 10 minutes. Confirm before the timer runs out.</p>
                        <ul id="seat-holds"></ul>
                        <button type="button" id="seat-confirm" class="custom-button" disabled>select seats</button>
                        <div id="seat-message" class="seat-message"></div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/user/assets/css/seatmap.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/user/assets/js/seatmap.js" asp-append-version="true"></script>
}

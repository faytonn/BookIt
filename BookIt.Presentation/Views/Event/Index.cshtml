@model BookIt.Presentation.Models.EventListViewModel
@{
    ViewData["Title"] = "Events";
    var f = Model.Filter;
}

<section class="search-ticket-section padding-top below-header">
    <div class="container">
        <div class="search-tab bg_img" data-background="~/user/assets/images/ticket/ticket-bg01.jpg">
            <div class="row align-items-center mb--20">
                <div class="col-lg-6 mb-20">
                    <div class="search-ticket-header">
                        <h6 class="category">find your event</h6>
                        <h3 class="title">upcoming events</h3>
                    </div>
                </div>
            </div>
            <div class="tab-area">
                <div class="tab-item active">
                    <form class="ticket-search-form" asp-action="Index" method="get">
                        <div class="form-group large">
                            <input type="text" name="SearchTerm" value="@f.SearchTerm" placeholder="Search for Events">
                            <button type="submit"><i class="fas fa-search"></i></button>
                        </div>
                        <div class="form-group">
                            <div class="thumb">
                                <img src="~/user/assets/images/ticket/city.png" alt="ticket">
                            </div>
                            <span class="type">location</span>
                            <select class="select-bar" name="LocationId">
                                <option value="">All Locations</option>
                                @foreach (var l in Model.Locations)
                                {
                                    <option value="@l.Value" selected="@l.Selected">@l.Text</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <div class="thumb">
                                <img src="~/user/assets/images/ticket/date.png" alt="ticket">
                            </div>
                            <span class="type">date</span>
                            <input type="date" name="Date" class="select-bar" value="@(f.Date?.ToString("yyyy-MM-dd"))">
                        </div>
                        <div class="form-group">
                            <div class="thumb">
                                <img src="~/user/assets/images/ticket/cinema.png" alt="ticket">
                            </div>
                            <span class="type">category</span>
                            <select class="select-bar" name="CategoryId">
                                <option value="">All Categories</option>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.Value" selected="@c.Selected">@c.Text</option>
                                }
                            </select>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="event-section padding-top padding-bottom bg-four">
    <div class="container">
        @if (!Model.Events.Items.Any())
        {
            <div class="section-header-2">
                <div class="left">
                    <h2 class="title">No events found</h2>
                    <p>Try a different search or <a asp-action="Index">clear the filters</a>.</p>
                </div>
            </div>
        }
        else
        {
            <div class="section-header-2">
                <div class="left">
                    <h2 class="title">@Model.Events.TotalCount event(s)</h2>
                    <p>Page @Model.Events.CurrentPage of @Model.Events.PageCount</p>
                </div>
            </div>
            <div class="row mb-30-none justify-content-center">
                @foreach (var evt in Model.Events.Items)
                {
                    <div class="col-sm-6 col-lg-4">
                        <div class="event-grid">
                            <div class="movie-thumb c-thumb">
                                <a asp-action="Details" asp-route-id="@evt.Id">
                                    <img src="@evt.ImagePath" alt="@evt.Title">
                                </a>
                                <div class="event-date">
                                    <h6 class="date-title">@evt.EventDate.Day</h6>
                                    <span>@evt.EventDate.ToString("MMM")</span>
                                </div>
                            </div>
                            <div class="movie-content bg-one">
                                <h5 class="title m-0">
                                    <a asp-action="Details" asp-route-id="@evt.Id">@evt.Title</a>
                                </h5>
                                <div class="movie-rating-percent">
                                    <span>@evt.LocationName &middot; @evt.CategoryName</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (Model.Events.PageCount > 1)
            {
                <ul class="pagination-area mt-40 justify-content-center d-flex">
                    @for (var p = 1; p <= Model.Events.PageCount; p++)
                    {
                        <li class="@(p == Model.Events.CurrentPage ? "active" : "") mx-1">
                            <a asp-action="Index"
                               asp-route-SearchTerm="@f.SearchTerm"
                               asp-route-LocationId="@f.LocationId"
                               asp-route-CategoryId="@f.CategoryId"
                               asp-route-Date="@(f.Date?.ToString("yyyy-MM-dd"))"
                               asp-route-Page="@p">@p</a>
                        </li>
                    }
                </ul>
            }
        }
    </div>
</section>

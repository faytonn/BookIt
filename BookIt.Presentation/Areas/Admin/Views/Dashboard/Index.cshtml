@using System.Globalization
@using BookIt.Domain.Enums
@model BookIt.Application.DTOs.DashboardDTO.GetDashboardDTO
@{
    ViewData["Title"] = "Dashboard";
    var inv = CultureInfo.InvariantCulture;
    string money(decimal v) => "€" + v.ToString("N0", inv);
    var fillPercent = Model.SeatsOnSale == 0 ? 0 : (int)Math.Round(100.0 * Model.NextEvents.Sum(e => e.SeatsSold) / Math.Max(1, Model.NextEvents.Sum(e => e.SeatsTotal)));
}

        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
            <div>
                <h3 class="fw-bold mb-1">Dashboard</h3>
                <h6 class="op-7 mb-2">Sales and seats across all venues, live from the database</h6>
            </div>
            <div class="ms-md-auto py-2 py-md-0">
                <a asp-controller="Reservation" asp-action="Index" class="btn btn-label-info btn-round me-2">Reservations</a>
                <a asp-controller="Event" asp-action="Create" class="btn btn-primary btn-round"><i class="fas fa-plus me-1"></i> New event</a>
            </div>
        </div>

        <!-- Stat cards -->
        <div class="row">
            <div class="col-sm-6 col-md-3">
                <div class="card card-stats card-round stat-card">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-icon">
                                <div class="icon-big text-center icon-primary bubble-shadow-small"><i class="fas fa-calendar-alt"></i></div>
                            </div>
                            <div class="col col-stats ms-3 ms-sm-0">
                                <div class="numbers">
                                    <p class="card-category">Upcoming events</p>
                                    <h4 class="card-title">@Model.UpcomingEvents</h4>
                                    <span class="stat-sub">@Model.SoldOutEvents sold out</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="card card-stats card-round stat-card">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-icon">
                                <div class="icon-big text-center icon-info bubble-shadow-small"><i class="fas fa-ticket-alt"></i></div>
                            </div>
                            <div class="col col-stats ms-3 ms-sm-0">
                                <div class="numbers">
                                    <p class="card-category">Tickets sold</p>
                                    <h4 class="card-title">@Model.TicketsSold.ToString("N0", inv)</h4>
                                    <span class="stat-sub">@Model.ConfirmedReservations.ToString("N0", inv) reservations</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="card card-stats card-round stat-card">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-icon">
                                <div class="icon-big text-center icon-success bubble-shadow-small"><i class="fas fa-euro-sign"></i></div>
                            </div>
                            <div class="col col-stats ms-3 ms-sm-0">
                                <div class="numbers">
                                    <p class="card-category">Revenue</p>
                                    <h4 class="card-title">@money(Model.Revenue)</h4>
                                    <span class="stat-sub">@money(Model.RevenueLast7Days) in the last 7 days</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="card card-stats card-round stat-card">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-icon">
                                <div class="icon-big text-center icon-secondary bubble-shadow-small"><i class="fas fa-hourglass-half"></i></div>
                            </div>
                            <div class="col col-stats ms-3 ms-sm-0">
                                <div class="numbers">
                                    <p class="card-category">Seats on hold now</p>
                                    <h4 class="card-title">@Model.ActiveHolds</h4>
                                    <span class="stat-sub">held for 10 min at checkout</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts -->
        <div class="row">
            <div class="col-md-8">
                <div class="card card-round">
                    <div class="card-header">
                        <div class="card-head-row">
                            <div class="card-title">Sales, last @Model.SalesByDay.Count days</div>
                        </div>
                        <div class="card-category">Revenue per day (bars) and tickets sold (line)</div>
                    </div>
                    <div class="card-body">
                        <div class="chart-box"><canvas id="salesChart"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-round">
                    <div class="card-header">
                        <div class="card-title">Tickets by category</div>
                        <div class="card-category">All time</div>
                    </div>
                    <div class="card-body">
                        @if (Model.SalesByCategory.Count == 0)
                        {
                            <p class="text-muted mb-0">No tickets sold yet.</p>
                        }
                        else
                        {
                            <div class="chart-box"><canvas id="categoryChart"></canvas></div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Next events -->
            <div class="col-md-7">
                <div class="card card-round">
                    <div class="card-header">
                        <div class="card-head-row card-tools-still-right">
                            <div class="card-title">Next events</div>
                            <div class="card-tools">
                                <a asp-controller="Event" asp-action="Index" class="btn btn-sm btn-label-primary btn-round">All events</a>
                            </div>
                        </div>
                        <div class="card-category">Seats sold so far: @fillPercent% across these shows</div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-items-center mb-0">
                                <tbody>
                                    @foreach (var e in Model.NextEvents)
                                    {
                                        <tr>
                                            <td style="width: 60px;"><img src="@e.ImagePath" alt="" class="event-row-thumb" /></td>
                                            <td>
                                                <div class="fw-bold">@e.Title</div>
                                                <small class="text-muted">@e.EventDate.ToString("ddd d MMM, HH:mm", inv) · @e.LocationName · @e.CategoryName</small>
                                            </td>
                                            <td style="width: 190px;">
                                                <div class="d-flex justify-content-between">
                                                    <small>@e.SeatsSold / @e.SeatsTotal</small>
                                                    <small class="fw-bold">@(e.PercentSold)%</small>
                                                </div>
                                                <div class="fill-bar @(e.PercentSold >= 100 ? "is-full" : null)"><span style="width: @(e.PercentSold)%"></span></div>
                                            </td>
                                        </tr>
                                    }
                                    @if (Model.NextEvents.Count == 0)
                                    {
                                        <tr><td class="text-muted p-4">No upcoming events.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent reservations -->
            <div class="col-md-5">
                <div class="card card-round">
                    <div class="card-header">
                        <div class="card-head-row card-tools-still-right">
                            <div class="card-title">Latest reservations</div>
                            <div class="card-tools">
                                <a asp-controller="Reservation" asp-action="Index" class="btn btn-sm btn-label-primary btn-round">View all</a>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-items-center mb-0">
                                <tbody>
                                    @foreach (var r in Model.RecentReservations)
                                    {
                                        var badge = r.Status switch
                                        {
                                            ReservationStatus.Confirmed => "badge-success",
                                            ReservationStatus.Pending => "badge-warning",
                                            ReservationStatus.Cancelled or ReservationStatus.Refunded => "badge-danger",
                                            _ => "badge-secondary"
                                        };
                                        <tr>
                                            <td>
                                                <a asp-controller="Reservation" asp-action="Details" asp-route-id="@r.Id" class="fw-bold">@r.EventTitle</a>
                                                <div><small class="text-muted">@r.UserEmail · @r.ReservationDate.ToString("d MMM HH:mm", inv)</small></div>
                                            </td>
                                            <td class="text-end">
                                                <div class="fw-bold">@money(r.TotalAmount)</div>
                                                <span class="badge @badge">@r.NumberOfTickets × · @r.Status</span>
                                            </td>
                                        </tr>
                                    }
                                    @if (Model.RecentReservations.Count == 0)
                                    {
                                        <tr><td class="text-muted p-4">No reservations yet.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

@section Scripts {
    <script>
        (function () {
            var days = @Json.Serialize(Model.SalesByDay.Select(d => d.Day.ToString("d MMM", inv)));
            var revenue = @Json.Serialize(Model.SalesByDay.Select(d => d.Revenue));
            var tickets = @Json.Serialize(Model.SalesByDay.Select(d => d.Tickets));

            new Chart(document.getElementById('salesChart'), {
                type: 'bar',
                data: {
                    labels: days,
                    datasets: [
                        { type: 'line', label: 'Tickets', data: tickets, yAxisID: 'tickets', borderColor: '#f25961', backgroundColor: 'transparent', pointBackgroundColor: '#f25961', borderWidth: 2, lineTension: 0.3 },
                        { label: 'Revenue (€)', data: revenue, yAxisID: 'revenue', backgroundColor: 'rgba(85, 96, 255, 0.75)' }
                    ]
                },
                options: {
                    maintainAspectRatio: false,
                    legend: { position: 'bottom' },
                    scales: {
                        yAxes: [
                            { id: 'revenue', position: 'left', ticks: { beginAtZero: true, callback: function (v) { return '€' + v; } } },
                            { id: 'tickets', position: 'right', gridLines: { display: false }, ticks: { beginAtZero: true, precision: 0 } }
                        ]
                    }
                }
            });

            var categoryCanvas = document.getElementById('categoryChart');
            if (categoryCanvas) {
                new Chart(categoryCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: @Json.Serialize(Model.SalesByCategory.Select(c => c.Name)),
                        datasets: [{
                            data: @Json.Serialize(Model.SalesByCategory.Select(c => c.TicketsSold)),
                            backgroundColor: ['#5560ff', '#aa52a1', '#f25961', '#31ce36', '#ffad46', '#48abf7', '#6861ce', '#1d7af3', '#8d9498']
                        }]
                    },
                    options: { maintainAspectRatio: false, cutoutPercentage: 62, legend: { position: 'bottom', labels: { boxWidth: 12 } } }
                });
            }
        })();
    </script>
}

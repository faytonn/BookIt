@using Microsoft.AspNetCore.Identity
@using BookIt.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var user = await UserManager.GetUserAsync(User);
    var displayName = user == null ? User.Identity?.Name : $"{user.FirstName} {user.LastName}".Trim();
    var initials = string.Concat((displayName ?? "A").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    var pageTitle = ViewData["Title"] as string ?? (controller == "Dashboard" ? "Dashboard" : controller);

    // Sidebar: (controller, icon, label, sub-links). Sub-links are (action, label).
    var groups = new (string Section, (string Controller, string Icon, string Label, (string Action, string Label)[] Links)[] Items)[]
    {
        ("Sales", new[]
        {
            ("Event", "fas fa-calendar-alt", "Events", new[] { ("Index", "All events"), ("Create", "New event"), ("Archived", "Archived") }),
            ("EventDetail", "fas fa-language", "Event details", new[] { ("Index", "All details"), ("Archived", "Archived") }),
            ("Reservation", "fas fa-ticket-alt", "Reservations", new[] { ("Index", "Active"), ("Create", "New reservation"), ("Cancelled", "Cancelled") }),
        }),
        ("Venues", new[]
        {
            ("GeneralLocation", "fas fa-map-marker-alt", "Locations", new[] { ("Index", "All locations"), ("Archived", "Archived") }),
            ("Hall", "fas fa-door-open", "Halls", new[] { ("Index", "All halls"), ("Archived", "Archived") }),
            ("SeatType", "fas fa-th-large", "Seat types", new[] { ("Index", "All seat types"), ("Archived", "Archived") }),
            ("Seat", "fas fa-chair", "Seats", new[] { ("Index", "All seats"), ("BulkCreate", "Bulk create"), ("Archived", "Archived") }),
        }),
        ("Catalog", new[]
        {
            ("Category", "fas fa-layer-group", "Categories", new[] { ("Index", "All categories"), ("Create", "New category"), ("Archived", "Archived") }),
        }),
        ("Door", new[]
        {
            ("CheckIn", "fas fa-qrcode", "Check-in", new[] { ("Index", "Scan tickets") }),
        }),
    };

    // Moderators are door staff: they only get the check-in page
    var isAdmin = User.IsInRole("Admin");
    var visibleGroups = isAdmin ? groups : groups.Where(g => g.Item1 == "Door").ToArray();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
    <title>@pageTitle · BookIt admin</title>
    <link rel="icon" href="~/admin/assets/img/kaiadmin/favicon.ico" type="image/x-icon" />

    <!-- Fonts and icons -->
    <script src="~/admin/assets/js/plugin/webfont/webfont.min.js"></script>
    <script>
        WebFont.load({
            google: { families: ["Public Sans:300,400,500,600,700"] },
            custom: {
                families: ["Font Awesome 5 Solid", "Font Awesome 5 Regular", "Font Awesome 5 Brands", "simple-line-icons"],
                urls: ["@Url.Content("~/admin/assets/css/fonts.min.css")"],
            },
            active: function () { sessionStorage.fonts = true; },
        });
    </script>

    <link rel="stylesheet" href="~/admin/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/admin/assets/css/plugins.min.css" />
    <link rel="stylesheet" href="~/admin/assets/css/kaiadmin.min.css" />
    <link rel="stylesheet" href="~/admin/assets/css/bookit-admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <div class="sidebar" data-background-color="dark">
            <div class="sidebar-logo">
                <div class="logo-header" data-background-color="dark">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="logo bookit-logo">
                        <img src="~/user/assets/images/logo/logo.png" alt="BookIt" height="30" />
                        <span class="badge bookit-badge">admin</span>
                    </a>
                    <div class="nav-toggle">
                        <button class="btn btn-toggle toggle-sidebar"><i class="gg-menu-right"></i></button>
                        <button class="btn btn-toggle sidenav-toggler"><i class="gg-menu-left"></i></button>
                    </div>
                    <button class="topbar-toggler more"><i class="gg-more-vertical-alt"></i></button>
                </div>
            </div>
            <div class="sidebar-wrapper scrollbar scrollbar-inner">
                <div class="sidebar-content">
                    <ul class="nav nav-secondary">
                        @if (isAdmin)
                        {
                            <li class="nav-item @(controller == "Dashboard" ? "active" : null)">
                                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fas fa-chart-pie"></i>
                                    <p>Dashboard</p>
                                </a>
                            </li>
                        }

                        @foreach (var (sectionName, items) in visibleGroups)
                        {
                            <li class="nav-section">
                                <span class="sidebar-mini-icon"><i class="fa fa-ellipsis-h"></i></span>
                                <h4 class="text-section">@sectionName</h4>
                            </li>
                            @foreach (var item in items)
                            {
                                var isActive = controller == item.Controller;
                                var collapseId = $"nav-{item.Controller.ToLowerInvariant()}";
                                <li class="nav-item @(isActive ? "active submenu" : null)">
                                    <a data-bs-toggle="collapse" href="#@collapseId" class="@(isActive ? null : "collapsed")" aria-expanded="@(isActive ? "true" : "false")">
                                        <i class="@item.Icon"></i>
                                        <p>@item.Label</p>
                                        <span class="caret"></span>
                                    </a>
                                    <div class="collapse @(isActive ? "show" : null)" id="@collapseId">
                                        <ul class="nav nav-collapse">
                                            @foreach (var link in item.Links)
                                            {
                                                <li class="@(isActive && action == link.Action ? "active" : null)">
                                                    <a asp-area="Admin" asp-controller="@item.Controller" asp-action="@link.Action">
                                                        <span class="sub-item">@link.Label</span>
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </li>
                            }
                        }

                        <li class="nav-section">
                            <span class="sidebar-mini-icon"><i class="fa fa-ellipsis-h"></i></span>
                            <h4 class="text-section">Site</h4>
                        </li>
                        <li class="nav-item">
                            <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener">
                                <i class="fas fa-external-link-alt"></i>
                                <p>View public site</p>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- End Sidebar -->

        <div class="main-panel">
            <div class="main-header">
                <div class="main-header-logo">
                    <div class="logo-header" data-background-color="dark">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="logo bookit-logo">
                            <img src="~/user/assets/images/logo/logo.png" alt="BookIt" height="30" />
                        </a>
                        <div class="nav-toggle">
                            <button class="btn btn-toggle toggle-sidebar"><i class="gg-menu-right"></i></button>
                            <button class="btn btn-toggle sidenav-toggler"><i class="gg-menu-left"></i></button>
                        </div>
                        <button class="topbar-toggler more"><i class="gg-more-vertical-alt"></i></button>
                    </div>
                </div>

                <nav class="navbar navbar-header navbar-header-transparent navbar-expand-lg border-bottom">
                    <div class="container-fluid">
                        <div class="bookit-page-title d-none d-lg-block">
                            <span class="text-muted">Admin /</span> <strong>@pageTitle</strong>
                        </div>
                        <ul class="navbar-nav topbar-nav ms-md-auto align-items-center">
                            <li class="nav-item me-3 d-none d-md-block">
                                <a class="btn btn-sm btn-border btn-round btn-primary" asp-area="" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener">
                                    <i class="fas fa-external-link-alt me-1"></i> View site
                                </a>
                            </li>
                            <li class="nav-item topbar-user dropdown hidden-caret">
                                <a class="dropdown-toggle profile-pic" data-bs-toggle="dropdown" href="#" aria-expanded="false">
                                    <div class="avatar-sm">
                                        <span class="avatar-title rounded-circle bookit-avatar">@initials</span>
                                    </div>
                                    <span class="profile-username">
                                        <span class="op-7">Hi,</span>
                                        <span class="fw-bold">@displayName</span>
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-user animated fadeIn">
                                    <li>
                                        <div class="user-box">
                                            <div class="avatar-lg">
                                                <span class="avatar-title rounded bookit-avatar">@initials</span>
                                            </div>
                                            <div class="u-text">
                                                <h4>@displayName</h4>
                                                <p class="text-muted">@user?.Email</p>
                                            </div>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">My profile</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Settings">Account settings</a>
                                        <div class="dropdown-divider"></div>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            <button type="submit" class="dropdown-item">Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>

            <div class="container">
                <div class="page-inner bookit-page">
                    @RenderBody()
                </div>
            </div>

            <footer class="footer">
                <div class="container-fluid d-flex justify-content-between">
                    <span class="text-muted">BookIt admin</span>
                    <span class="text-muted">&copy; @DateTime.Now.Year BookIt</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- Core JS -->
    <script src="~/admin/assets/js/core/jquery-3.7.1.min.js"></script>
    <script src="~/admin/assets/js/core/popper.min.js"></script>
    <script src="~/admin/assets/js/core/bootstrap.min.js"></script>
    <script src="~/admin/assets/js/plugin/jquery-scrollbar/jquery.scrollbar.min.js"></script>
    <script src="~/admin/assets/js/plugin/chart.js/chart.min.js"></script>
    <script src="~/admin/assets/js/plugin/datatables/datatables.min.js"></script>
    <script src="~/admin/assets/js/plugin/sweetalert/sweetalert.min.js"></script>
    <script src="~/admin/assets/js/kaiadmin.min.js"></script>
    <script>
        $('.scrollbar-inner').scrollbar();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

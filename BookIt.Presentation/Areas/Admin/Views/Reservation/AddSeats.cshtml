@using System.Globalization
@using BookIt.Application.DTOs.EventSeatDTO
@using BookIt.Application.DTOs.ReservationDTO
@model GetReservationDTO

@{
    ViewData["Title"] = $"Add seats to #{Model.Id}";
    var inv = CultureInfo.InvariantCulture;
    var available = (List<GetEventSeatDTO>)ViewBag.AvailableSeats;
}

<div class="d-flex align-items-center pb-3">
    <div>
        <h3 class="fw-bold mb-1">Add seats to reservation #@Model.Id</h3>
        <h6 class="op-7 mb-0">@Model.EventTitle · @Model.CustomerName · now @Model.NumberOfTickets ticket(s), €@Model.TotalAmount.ToString("N2", inv)</h6>
    </div>
    <div class="ms-auto">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-label-info btn-round"><i class="fas fa-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="card card-round">
    <div class="card-body">
        <form asp-action="AddSeats" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            @if (available.Count == 0)
            {
                <p class="text-muted mb-0">No free seats left for this event.</p>
            }
            else
            {
                <div class="form-group px-0">
                    <label class="fw-bold mb-2">Free seats (@available.Count)</label>
                    <select name="seatIds" class="form-select" multiple size="14">
                        @foreach (var seat in available)
                        {
                            <option value="@seat.SeatId">@seat.SeatName · row @seat.Row, seat @seat.Column · @seat.SeatTypeName · €@seat.Price.ToString("N2", inv)</option>
                        }
                    </select>
                    <small class="form-text text-muted">Hold Ctrl (or Cmd) to pick several seats.</small>
                </div>
                <button type="submit" class="btn btn-primary btn-round"><i class="fas fa-plus me-1"></i> Add selected seats</button>
            }
        </form>
    </div>
</div>

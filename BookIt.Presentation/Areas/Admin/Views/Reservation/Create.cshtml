@using BookIt.Application.DTOs.ReservationDTO
@model CreateReservationDTO

@{
    ViewData["Title"] = "Create Reservation";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-gray-800">Create Reservation</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Reservation Information</h6>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" id="reservationForm">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="CustomerEmail" class="control-label">Customer email</label>
                    <input asp-for="CustomerEmail" type="email" class="form-control" placeholder="customer@example.com" />
                    <small class="form-text text-muted">The booking is made for this customer's account and the seats are sold right away.</small>
                    <span asp-validation-for="CustomerEmail" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EventId" class="control-label">Event</label>
                    <select asp-for="EventId" class="form-control" asp-items="ViewBag.Events">
                        <option value="">-- Select Event --</option>
                    </select>
                    <span asp-validation-for="EventId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SeatIds" class="control-label">Select Seats</label>
                    <select asp-for="SeatIds" class="form-control" multiple size="8" id="seatSelect">
                    </select>
                    <small class="form-text text-muted">Hold Ctrl (Windows) or Command (Mac) to select multiple seats</small>
                    <span asp-validation-for="SeatIds" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            $('#EventId').change(function () {
                var eventId = $(this).val();
                if (eventId) {
                    $.get('/Admin/Reservation/GetAvailableSeats', { eventId: eventId }, function (seats) {
                        var seatSelect = $('#seatSelect');
                        seatSelect.empty();
                        seats.forEach(function (seat) {
                            seatSelect.append($('<option></option>')
                                .val(seat.id)
                                .text(seat.name + ' (Row ' + seat.row + ', Column ' + seat.column + ') - €' + seat.price.toFixed(2)));
                        });
                    });
                } else {
                    $('#seatSelect').empty();
                }
            });

            if ($('#EventId').val()) {
                $('#EventId').trigger('change');
            }
        });
    </script>
} 
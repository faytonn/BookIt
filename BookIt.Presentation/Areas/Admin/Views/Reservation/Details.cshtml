@using System.Globalization
@using BookIt.Application.DTOs.ReservationDTO
@using BookIt.Domain.Enums
@model GetReservationDTO

@{
    ViewData["Title"] = $"Reservation #{Model.Id}";
    var inv = CultureInfo.InvariantCulture;
    var isOpen = Model.Status is not (ReservationStatus.Cancelled or ReservationStatus.Refunded);
    var isPast = Model.EventDate < DateTime.Now;
    // ApplicationUser.CreatedAt is not set on register yet, and the audit interceptor writes "undefined" without a user
    var customerSince = Model.CustomerSince?.Year > 2000 ? Model.CustomerSince : null;
    string who(string? by) => string.IsNullOrEmpty(by) || by == "undefined" ? "system" : by;
    var badge = Model.Status switch
    {
        ReservationStatus.Confirmed => "badge-success",
        ReservationStatus.Cancelled => "badge-danger",
        ReservationStatus.Pending => "badge-warning",
        ReservationStatus.Waitlisted => "badge-info",
        _ => "badge-secondary"
    };
}

<div class="d-flex align-items-left align-items-md-center flex-column flex-md-row pb-3">
    <div>
        <h3 class="fw-bold mb-1">@Model.Code <small class="text-muted fs-6">#@Model.Id</small> <span class="badge @badge align-middle ms-2">@Model.Status</span></h3>
        <h6 class="op-7 mb-0">Booked @Model.ReservationDate.ToString("d MMM yyyy, HH:mm", inv) · @Model.NumberOfTickets ticket(s) · €@Model.TotalAmount.ToString("N2", inv)</h6>
    </div>
    <div class="ms-md-auto py-2 py-md-0">
        <a asp-action="Index" class="btn btn-label-info btn-round me-2"><i class="fas fa-arrow-left me-1"></i> All reservations</a>
        <a href="/tickets/@Model.Code" target="_blank" rel="noopener" class="btn btn-label-primary btn-round me-2"><i class="fas fa-qrcode me-1"></i> Customer's tickets</a>
        @if (Model.Status == ReservationStatus.Pending)
        {
            <form asp-action="Confirm" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-success btn-round me-2" onclick="return confirm('Confirm this reservation?')"><i class="fas fa-check me-1"></i> Confirm</button>
            </form>
        }
        @if (isOpen)
        {
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-danger btn-round" onclick="return confirm('Cancel this reservation? Its seats go back on sale.')"><i class="fas fa-ban me-1"></i> Cancel reservation</button>
            </form>
        }
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}

<div class="row">
    <!-- Customer -->
    <div class="col-md-4">
        <div class="card card-round">
            <div class="card-header"><div class="card-title">Customer</div></div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="avatar avatar-lg me-3">
                        <span class="avatar-title rounded-circle bookit-avatar">@(string.Concat(Model.CustomerName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0]))))</span>
                    </div>
                    <div>
                        <div class="fw-bold fs-5">@(string.IsNullOrWhiteSpace(Model.CustomerName) ? "Unknown customer" : Model.CustomerName)</div>
                        @if (customerSince.HasValue)
                        {
                            <small class="text-muted">Customer since @customerSince.Value.ToString("MMM yyyy", inv)</small>
                        }
                    </div>
                </div>
                <dl class="row mb-0 detail-list">
                    <dt class="col-4">Email</dt>
                    <dd class="col-8">
                        <a href="mailto:@Model.CustomerEmail">@Model.CustomerEmail</a>
                        @if (!Model.CustomerEmailConfirmed)
                        {
                            <span class="badge badge-warning ms-1">unconfirmed</span>
                        }
                    </dd>
                    <dt class="col-4">Phone</dt>
                    <dd class="col-8">
                        @if (string.IsNullOrWhiteSpace(Model.CustomerPhone))
                        {
                            <span class="text-muted">not given</span>
                        }
                        else
                        {
                            <a href="tel:@Model.CustomerPhone">@Model.CustomerPhone</a>
                        }
                    </dd>
                    <dt class="col-4">Address</dt>
                    <dd class="col-8">@(string.IsNullOrWhiteSpace(Model.CustomerAddress) ? "not given" : Model.CustomerAddress)</dd>
                    <dt class="col-4">User ID</dt>
                    <dd class="col-8"><small class="text-muted text-break">@Model.UserId</small></dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Event -->
    <div class="col-md-4">
        <div class="card card-round">
            <div class="card-header"><div class="card-title">Event</div></div>
            <div class="card-body">
                <div class="fw-bold fs-5 mb-1">@Model.EventTitle</div>
                @if (isPast)
                {
                    <span class="badge badge-secondary mb-2">event has taken place</span>
                }
                <dl class="row mb-0 detail-list">
                    <dt class="col-4">Date</dt>
                    <dd class="col-8">@Model.EventDate.ToString("ddd d MMM yyyy, HH:mm", inv)</dd>
                    <dt class="col-4">Venue</dt>
                    <dd class="col-8">@Model.LocationName</dd>
                    <dt class="col-4">Hall</dt>
                    <dd class="col-8">@Model.HallName</dd>
                </dl>
                <div class="mt-3">
                    <a asp-area="" asp-controller="Event" asp-action="Details" asp-route-id="@Model.EventId" target="_blank" rel="noopener" class="btn btn-sm btn-label-primary btn-round">Public page</a>
                    <a asp-controller="Event" asp-action="Update" asp-route-id="@Model.EventId" class="btn btn-sm btn-label-info btn-round">Edit event</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment + history -->
    <div class="col-md-4">
        <div class="card card-round">
            <div class="card-header"><div class="card-title">Payment &amp; history</div></div>
            <div class="card-body">
                <dl class="row mb-0 detail-list">
                    <dt class="col-5">Total</dt>
                    <dd class="col-7 fw-bold">€@Model.TotalAmount.ToString("N2", inv)</dd>
                    <dt class="col-5">Payment</dt>
                    <dd class="col-7">
                        @if (Model.PaymentTransactionId.HasValue)
                        {
                            <span>Transaction #@Model.PaymentTransactionId</span>
                        }
                        else
                        {
                            <span class="text-muted">no payment recorded</span>
                        }
                    </dd>
                    @if (Model.RefundAmount.HasValue)
                    {
                        <dt class="col-5">Refund</dt>
                        <dd class="col-7">
                            @if (Model.IsRefunded)
                            {
                                <span class="badge badge-success">€@Model.RefundAmount.Value.ToString("N2", inv) refunded</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">€@Model.RefundAmount.Value.ToString("N2", inv) owed</span>
                                <form asp-action="MarkRefunded" asp-route-id="@Model.Id" method="post" class="mt-2">
                                    <button type="submit" class="btn btn-sm btn-success btn-round" onclick="return confirm('Mark €@Model.RefundAmount.Value.ToString("N2", inv) as paid back to the customer?')">Mark as refunded</button>
                                </form>
                            }
                            @if (Model.CancelledAt.HasValue)
                            {
                                <div><small class="text-muted">cancelled @Model.CancelledAt.Value.ToString("d MMM yyyy, HH:mm", inv)</small></div>
                            }
                        </dd>
                    }
                    <dt class="col-5">Created</dt>
                    <dd class="col-7">@Model.CreatedAt.ToString("d MMM yyyy, HH:mm", inv)<br /><small class="text-muted">by @who(Model.CreatedBy)</small></dd>
                    <dt class="col-5">Last change</dt>
                    <dd class="col-7">@Model.UpdatedAt.ToString("d MMM yyyy, HH:mm", inv)<br /><small class="text-muted">by @who(Model.UpdatedBy)</small></dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- Seats -->
<div class="card card-round">
    <div class="card-header">
        <div class="card-head-row card-tools-still-right">
            <div class="card-title">Seats (@Model.Seats.Count)</div>
            @if (isOpen && !isPast)
            {
                <div class="card-tools">
                    <a asp-action="AddSeats" asp-route-id="@Model.Id" class="btn btn-sm btn-primary btn-round"><i class="fas fa-plus me-1"></i> Add seats</a>
                </div>
            }
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Seat</th>
                        <th>Row</th>
                        <th>Column</th>
                        <th>Type</th>
                        <th>Ticket</th>
                        <th class="text-end">Price</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var seat in Model.Seats.OrderBy(s => s.Row).ThenBy(s => s.Column))
                    {
                        <tr>
                            <td class="fw-bold">@seat.SeatName</td>
                            <td>@seat.Row</td>
                            <td>@seat.Column</td>
                            <td>@seat.SeatType</td>
                            <td>
                                @* only the end of the code: the full code is the ticket itself *@
                                <code title="Ticket code (last 4)">…@(seat.TicketCode.Length > 4 ? seat.TicketCode[^4..] : seat.TicketCode)</code>
                                @if (seat.CheckedInAt.HasValue)
                                {
                                    <span class="badge badge-success ms-1">in @seat.CheckedInAt.Value.ToLocalTime().ToString("HH:mm", inv)</span>
                                }
                            </td>
                            <td class="text-end">€@seat.Price.ToString("N2", inv)</td>
                            <td class="text-end">
                                @if (isOpen && !isPast)
                                {
                                    <form asp-action="RemoveSeats" asp-route-id="@Model.Id" method="post">
                                        <input type="hidden" name="seatIds" value="@seat.SeatId" />
                                        <button type="submit" class="btn btn-sm btn-label-danger" title="Remove seat" onclick="return confirm('Remove seat @seat.SeatName? It goes back on sale.')"><i class="fas fa-times"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Seats.Count == 0)
                    {
                        <tr><td colspan="7" class="text-muted p-4">No seats on this reservation.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

# Copy to .env and fill in. .env is gitignored; never commit real values.
# ASP.NET Core reads these as configuration: "__" separates sections
# (CloudinarySettings__APIKey == CloudinarySettings:APIKey).
# Local `dotnet run` uses `dotnet user-secrets` instead; this file is for docker compose / the VM.

ASPNETCORE_ENVIRONMENT=Production
APP_PORT=8080
# Absolute site address for links in emails (ticket page). On the VM: http://<static-ip>
App__PublicBaseUrl=http://localhost:8080

# SQL Server
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
ConnectionStrings__DefaultConnection=Server=sqlserver;Database=BookItDB;User Id=sa;Password=ChangeMe_Str0ng!;TrustServerCertificate=true

# Cloudinary (image uploads)
CloudinarySettings__CloudName=your-cloud-name
CloudinarySettings__APIKey=your-api-key
CloudinarySettings__APISecret=your-api-secret

# SMTP (MailKit)
MailKitoptions__Mail=you@example.com
MailKitoptions__Password=your-app-password
MailKitoptions__Host=smtp.gmail.com
MailKitoptions__Port=587

# Seeded admin user (created on first start if missing)
Admin__Username=Admin
Admin__FirstName=Admin
Admin__LastName=Admin
Admin__Email=admin@example.com
Admin__Password=ChangeMe_Str0ng!

# OpenTelemetry -> Grafana Cloud
# Get these from Grafana Cloud: Connections -> OpenTelemetry (OTLP) -> View connection details
OTEL_SERVICE_NAME=<service-name>
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64-of-instanceId:token>

# RabbitMQ (seat-sold -> confirmation email). Compose creates this user on the broker.
# Leave RabbitMq__Host empty to disable messaging.
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__User=bookit
RabbitMq__Password=ChangeMe_Str0ng!

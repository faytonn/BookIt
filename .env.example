# Copy to .env and fill in. .env is gitignored; never commit real values.
# ASP.NET Core reads these as configuration: "__" separates sections
# (CloudinarySettings__APIKey == CloudinarySettings:APIKey).
# Local `dotnet run` uses `dotnet user-secrets` instead; this file is for docker compose / the VM.

ASPNETCORE_ENVIRONMENT=Production

# SQL Server
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!
ConnectionStrings__DefaultConnection=Server=sqlserver;Database=BookItDB;User Id=sa;Password=ChangeMe_Str0ng!;TrustServerCertificate=true

# Cloudinary (image uploads)
CloudinarySettings__CloudName=your-cloud-name
CloudinarySettings__APIKey=your-api-key
CloudinarySettings__APISecret=your-api-secret

# SMTP (MailKit)
MailKitoptions__Mail=you@example.com
MailKitoptions__Password=your-app-password
MailKitoptions__Host=smtp.gmail.com
MailKitoptions__Port=587

# Seeded admin user (created on first start if missing)
Admin__Username=Admin
Admin__FirstName=Admin
Admin__LastName=Admin
Admin__Email=admin@example.com
Admin__Password=ChangeMe_Str0ng!
